# Vack Voice — Production env template
# Copy to .env (next to package.json) and fill in real values.

# Port the app listens on
PORT=3001

# Public URL of the app (used for referral links + share links)
# e.g. SITE_URL=https://vackvoice.com
SITE_URL=

# Paystack keys — https://dashboard.paystack.com/#/settings/developers
# Use test keys first (sk_test_...), switch to live (sk_live_...) when ready.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_BASE_URL=https://api.paystack.co
